# Copy this file to ".env" and fill in ONLY what you want to use.
# The CLI can ALSO take a private key by raw paste at the prompt — env vars are optional.
# NEVER commit your real .env file.

# --- EVM ---
# Hex private key, with or without the 0x prefix.
EVM_PRIVATE_KEY=

# Optional: override a preset RPC without editing code.
# EVM_RPC_URL=

# --- Solana ---
# Either a base58 secret key string, OR a JSON array like [12,34,...].
SOLANA_PRIVATE_KEY=

# Optional: override the Solana RPC.
# SOLANA_RPC_URL=

# --- Telegram bot ---
# Token from @BotFather (looks like "1234567890:AAF...").
# This lets the program act as your bot. Treat it like a password.
# It is loaded at runtime from here and is NEVER committed (.env is git-ignored).
TELEGRAM_BOT_TOKEN=

# Optional: lock the bot to ONLY respond to your Telegram account.
# Your numeric Telegram user ID (get it by messaging @userinfobot).
# Strongly recommended — without it, anyone who finds your bot could use it.
TELEGRAM_ALLOWED_USER_ID=

# Optional: password used to encrypt stored wallet keys at rest.
# If left blank, the bot derives one from your token automatically.
# Set your own for stronger separation (any long random phrase).
WALLET_ENCRYPTION_PASSWORD=

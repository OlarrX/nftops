# Copy this file to ".env" and fill in ONLY what you want to use.
# The CLI can ALSO take a private key by raw paste at the prompt — env vars are optional.
# NEVER commit your real .env file.

# --- EVM ---
# Hex private key, with or without the 0x prefix.
EVM_PRIVATE_KEY=

# Optional: override a preset RPC without editing code.
# EVM_RPC_URL=

# --- Solana ---
# Either a base58 secret key string, OR a JSON array like [12,34,...].
SOLANA_PRIVATE_KEY=

# Optional: override the Solana RPC.
# SOLANA_RPC_URL=
